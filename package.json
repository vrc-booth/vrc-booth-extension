{
  "name": "boothplus",
  "description": "manifest.json description",
  "private": true,
  "version": "3.3.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "preview": "vite --config preview.vite.config.ts",
    "release:metadata": "node scripts/release.mjs metadata",
    "release:gate": "node scripts/release.mjs gate",
    "release:package": "wxt zip && wxt zip -b firefox && python3 -B scripts/release-packages.py --normalize",
    "release:verify": "python3 -B scripts/release-packages.py",
    "test:release": "vitest run tests/release.test.ts && python3 -B -m unittest discover -s tests -p \"release_*.py\"",
    "check": "vitest run && tsc --noEmit && wxt build && wxt build -b firefox",
    "test:cws": "vitest run tests/cws-*.test.ts && python3 -B -m unittest discover -s tests -p \"cws_*.py\"",
    "release:chrome:package": "wxt zip --sources && python3 -B scripts/release-packages.py --normalize --chrome-only"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.35.0",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/react-query": "^5.90.9",
    "@webext-core/messaging": "^2.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-toastify": "^11.0.5",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@wxt-dev/i18n": "^0.2.4",
    "@wxt-dev/module-react": "^1.1.3",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.2",
    "vite": "7.2.2",
    "vitest": "^5.0.3",
    "wxt": "^0.20.6"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "24.x"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "overrides": {
    "esbuild": "0.25.12"
  }
}
